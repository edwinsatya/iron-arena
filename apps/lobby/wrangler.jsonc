{
  // IRON ARENA lobby — Cloudflare Worker + one Durable Object per room (PLAN §4.7, §12)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iron-arena-lobby",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RoomDO" }],
  },
  // Free plan: SQLite-backed Durable Objects
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO"] }],
  "vars": {
    // Comma-separated list of the sites allowed to create rooms ("https://host" or just "host"), or "*"
    "ALLOWED_ORIGINS": "https://iron-arena.touchsimpledev.site",
  },
  "dev": { "port": 8787 },
  // Secrets (not in this file): wrangler secret put TURN_KEY_ID / TURN_KEY_API_TOKEN
  "observability": { "enabled": true },
}
