{
  // IRON ARENA lobby — Cloudflare Worker + one Durable Object per room (PLAN §4.7, §12)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iron-arena-lobby",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "ArenaRoom" }],
  },
  // Free plan: SQLite-backed Durable Objects. v2 replaces the room class with a new one, so its
  // storage is created under the Worker's current name; rooms only live while people play, so
  // nothing worth keeping is deleted.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomDO"] },
    { "tag": "v2", "new_sqlite_classes": ["ArenaRoom"], "deleted_classes": ["RoomDO"] },
  ],
  "vars": {
    // Comma-separated list of the sites allowed to create rooms ("https://host" or just "host"), or "*"
    "ALLOWED_ORIGINS": "https://iron-arena.touchsimpledev.site",
  },
  "dev": { "port": 8787 },
  // Secrets (not in this file): wrangler secret put TURN_KEY_ID / TURN_KEY_API_TOKEN
  "observability": { "enabled": true },
}
